<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/date"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="17sp"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/fg"
            android:textSize="17sp"
            android:textStyle="bold" />


        <!-- Neue Version verfügbar: ein Tipp lädt und installiert sie -->
        <ImageView
            android:id="@+id/update"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Neue Version installieren"
            android:scaleType="fitCenter"
            android:src="@drawable/ring_update"
            android:visibility="gone" />

        <!-- Zahnrad: Einstellungen der App -->
        <ImageView
            android:id="@+id/settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Einstellungen"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gear" />

        <ImageView
            android:id="@+id/home"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="18dp"
            android:contentDescription="Home-Modus"
            android:scaleType="fitCenter"
            android:src="@drawable/ring_home_off"
            android:visibility="gone" />

        <!-- Aktualisieren: grüner Ring mit Pfeil, darunter gut lesbar die Versionsnummer -->
        <LinearLayout
            android:id="@+id/refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:contentDescription="Aktualisieren">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ring_refresh" />

            <TextView
                android:id="@+id/stamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/fg"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Lädt …"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- Geburtstagsliste blättern: groß unter den Einträgen, wie bei den Kalenderwochen -->
    <LinearLayout
        android:id="@+id/bdnav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/bdprev"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="◀"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/bdpage"
            android:layout_width="84dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bdnext"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />
    </LinearLayout>

    <!-- Unten: Wochenvorschau (KW mit Pfeilen), Geburtstage umschalten und ＋ für die Schnelleingabe -->
    <LinearLayout
        android:id="@+id/quick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <!-- Links: Kassenbuch (€) über dem B, gegenüber der Zaubertaste -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cash"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/ring_cash"
                android:contentDescription="Kassenbuch"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="€"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/q_bdays"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Geburtstage">

                <ImageView
                    android:id="@+id/q_bdring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ring_bd" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="B"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <!-- Tage bis zum nächsten Geburtstag (wie in der App), nur in der Erinnerungszeit -->
                <TextView
                    android:id="@+id/q_bdn"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:minWidth="16dp"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:background="@drawable/bd_badge"
                    android:textColor="#111111"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/weekprev"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="◀"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:visibility="invisible" />

        <!-- Jahreszahl über dem KW-Knopf, sobald die Woche im nächsten Jahr liegt -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/weekyear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fg"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/weeklabel"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:background="@drawable/kw_off"
                android:gravity="center"
                android:maxLines="1"
                android:text="KW"
                android:textColor="@color/fg"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/weeknext"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:visibility="invisible" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Rechts: Zaubertaste (Claude fragen) über dem ＋ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ask"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp"
                android:contentDescription="Claude fragen"
                android:scaleType="fitCenter"
                android:src="@drawable/ring_ask" />

            <ImageView
                android:id="@+id/q_add"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Neuer Eintrag"
                android:scaleType="fitCenter"
                android:src="@drawable/ring_add" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
