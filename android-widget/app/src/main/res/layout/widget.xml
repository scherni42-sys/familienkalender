<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Heute"
            android:textColor="@color/fg"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/bdnav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/bdprev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/fg"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bdpage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fg"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/bdnext"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="›"
                android:textColor="@color/fg"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/stamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/refresh"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Aktualisieren"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Lädt …"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- Wochenvorschau: Antippen schaltet um, Pfeile blättern die Kalenderwochen -->
    <LinearLayout
        android:id="@+id/weekbar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bar_off"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/weekprev"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/fg"
            android:textSize="28sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/weeklabel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:text="📅 Wochenvorschau"
            android:textColor="@color/fg"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/weeknext"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/fg"
            android:textSize="28sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- Schnellknöpfe: sprechen direkt als privater Termin, Familientermin oder Pinnwand-Nachricht -->
    <LinearLayout
        android:id="@+id/quick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/q_private"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:background="@drawable/btn_private"
            android:gravity="center"
            android:text="Privat"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/q_family"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_family"
            android:gravity="center"
            android:text="Familie"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/q_board"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_board"
            android:gravity="center"
            android:text="Pinnwand"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/q_bdays"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_bdays"
            android:contentDescription="Geburtstage"
            android:gravity="center"
            android:text="🎂"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
