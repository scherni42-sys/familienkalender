<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fam-TO"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="1. Öffne Fam-TO und gehe zu Einstellungen → Displays.\n2. Tippe auf „Widget-Code für Android kopieren“.\n3. Füge den Code hier ein und tippe auf Speichern.\n4. Lege das Widget über den Startbildschirm an: lange drücken → Widgets → Fam-TO.\n\nSpäter ändern: lange auf das Symbol „Fam-TO“ drücken → Widget einrichten."
            android:textSize="15sp" />

        <EditText
            android:id="@+id/code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Widget-Code (beginnt mit FK1:)"
            android:inputType="textNoSuggestions|textMultiLine"
            android:minLines="3"
            android:textSize="13sp" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Speichern" />

        <CheckBox
            android:id="@+id/remind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Erinnerungen als Benachrichtigung: 30 Min vor meinen Terminen (bzw. vor der Abfahrt) und an Geburtstage"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/calsync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Termine im Kalender des Handys anzeigen (Samsung-Kalender: eigener Kalender „Fam-TO“, nur lesen)"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/calimport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Meine Handy-Termine als private Termine in Fam-TO übernehmen (ganztägige mit „Geburtstag“ werden private Geburtstage)"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/impcals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/impstatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/geo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Home-Modus automatisch, wenn ich zu Hause bin (berufliche Termine ausblenden). Der 🏠-Knopf im Widget übersteuert."
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/geobox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/geohere"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hier ist Zuhause" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:text="Umkreis"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/georadius"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="4"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="m"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/geostatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/syncnow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jetzt abgleichen" />

            <Button
                android:id="@+id/update"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Neue Version laden" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
