<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Familien-Widget"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="1. Öffne den Familienkalender und gehe zu Einstellungen → Displays.\n2. Tippe auf „Widget-Code für Android kopieren“.\n3. Füge den Code hier ein und tippe auf Speichern.\n4. Lege das Widget über den Startbildschirm an: lange drücken → Widgets → Familie sprechen.\n\nSpäter ändern: lange auf das Symbol „Familie sprechen“ drücken → Widget einrichten."
            android:textSize="15sp" />

        <EditText
            android:id="@+id/code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Widget-Code (beginnt mit FK1:)"
            android:inputType="textNoSuggestions|textMultiLine"
            android:minLines="3"
            android:textSize="13sp" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Speichern" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
